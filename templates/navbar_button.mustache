{{!
    @template local_scribbles/navbar_button

    The navbar button (next to the edit mode switch) that opens scribbles.

    Example context (json):
    {}
}}
<div class="local_scribbles-navbar d-flex align-items-center">
    <button type="button" class="btn btn-icon local_scribbles-navbutton" data-action="local_scribbles-open"
            title="{{#str}}openscribbles, local_scribbles{{/str}}" aria-label="{{#str}}openscribbles, local_scribbles{{/str}}">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 3l5 5-10 10H6v-5z"/><path d="M13.5 5.5l5 5"/><path d="M3 21c1.5-1.5 3 1.5 4.5 0s3 1.5 4.5 0"/></svg>
    </button>
</div>
