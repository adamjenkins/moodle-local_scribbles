{{!
    @template local_scribbles/list

    The current user's saved scribbles.

    Context variables required for this template:
    * hasitems - whether there is anything to show
    * items - saved screenshots: imageurl, downloadurl, deleteurl, pagetitle, pageurl, timecreated

    Example context (json):
    {
        "hasitems": true,
        "items": [
            {
                "imageurl": "https://example.com/pluginfile.php/5/local_scribbles/screenshot/1/scribble.png",
                "downloadurl": "https://example.com/pluginfile.php/5/local_scribbles/screenshot/1/scribble.png?forcedownload=1",
                "deleteurl": "https://example.com/local/scribbles/index.php?action=delete&id=1",
                "pagetitle": "Course: Biology 101",
                "pageurl": "https://example.com/course/view.php?id=2",
                "timecreated": "Monday, 19 October 2026, 9:30 AM"
            }
        ]
    }
}}
{{#hasitems}}
<div class="local_scribbles-list">
    {{#items}}
    <div class="card local_scribbles-item">
        <a href="{{imageurl}}" target="_blank" rel="noopener">
            <img class="card-img-top local_scribbles-thumb" src="{{imageurl}}" alt="{{pagetitle}}" loading="lazy">
        </a>
        <div class="card-body">
            <h3 class="h6 card-title text-truncate" title="{{pagetitle}}">
                {{#pageurl}}<a href="{{pageurl}}">{{pagetitle}}</a>{{/pageurl}}
                {{^pageurl}}{{pagetitle}}{{/pageurl}}
            </h3>
            <p class="card-text small text-muted">{{timecreated}}</p>
            <a class="btn btn-secondary btn-sm" href="{{downloadurl}}">{{#str}}download, local_scribbles{{/str}}</a>
            <a class="btn btn-outline-danger btn-sm" href="{{deleteurl}}">{{#str}}delete{{/str}}</a>
        </div>
    </div>
    {{/items}}
</div>
{{/hasitems}}
{{^hasitems}}
<p>{{#str}}noscribbles, local_scribbles{{/str}}</p>
{{/hasitems}}
