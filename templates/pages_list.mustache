{{!
    @template local_scribbles/pages_list

    The current user's saved annotation pages.

    Context variables required for this template:
    * haspages - whether there is anything to show
    * pages - saved pages: name, openurl, deleteurl, pagetitle, timemodified

    Example context (json):
    {
        "haspages": true,
        "pages": [
            {
                "name": "Week 3 notes",
                "openurl": "https://example.com/course/view.php?id=2#local_scribbles_page-1",
                "deleteurl": "https://example.com/local/scribbles/index.php?action=deletepage&id=1",
                "pagetitle": "Course: Biology 101",
                "timemodified": "Monday, 19 October 2026, 9:30 AM"
            }
        ]
    }
}}
{{#haspages}}
<div class="local_scribbles-list">
    {{#pages}}
    <div class="card local_scribbles-item">
        <div class="card-body">
            <h4 class="h6 card-title text-truncate" title="{{name}}">{{name}}</h4>
            <p class="card-text small text-muted mb-1 text-truncate" title="{{pagetitle}}">{{pagetitle}}</p>
            <p class="card-text small text-muted">{{timemodified}}</p>
            <a class="btn btn-secondary btn-sm" href="{{openurl}}">{{#str}}openpage, local_scribbles{{/str}}</a>
            <a class="btn btn-outline-danger btn-sm" href="{{deleteurl}}">{{#str}}delete{{/str}}</a>
        </div>
    </div>
    {{/pages}}
</div>
{{/haspages}}
{{^haspages}}
<p>{{#str}}nopages, local_scribbles{{/str}}</p>
{{/haspages}}
